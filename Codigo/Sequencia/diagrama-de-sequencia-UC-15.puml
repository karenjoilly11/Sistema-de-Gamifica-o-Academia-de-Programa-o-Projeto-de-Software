@startuml
title DevLevel - Gerenciar Monitoria (UC-15)

actor Mentor as M
participant "Interface\nWeb" as UI
participant "Controlador\nMentoria" as CM
participant "Serviço de\nAutenticação" as Auth
participant "Serviço de\nPermissões" as Perm
participant "Serviço de\nMentoria" as SM
participant "Repositório\nde Dados" as Repo
database "Banco de\nDados" as DB
participant "Sistema de\nNotificação" as Notif

== 1. Visualização de Solicitações Pendentes ==

M -> UI: 1.1 acessarSolicitacoesPendentes()
activate UI

UI -> CM: 1.2 listarSolicitacoesPendentes(token)
activate CM

CM -> Auth: 1.3 verificarToken(token)
activate Auth
Auth --> CM: 1.4 usuarioAutenticado
deactivate Auth

CM -> Perm: 1.5 verificarPapel(usuario, "MENTOR")
activate Perm
Perm --> CM: 1.6 permissaoValida
deactivate Perm

CM -> Repo: 1.7 buscarSolicitacoesPorMentor(mentorId)
activate Repo
Repo -> DB: 1.8 SELECT m.*, a.nome as aluno_nome\nFROM mentorias m\nJOIN alunos a ON m.aluno_id = a.id\nWHERE m.mentor_id = ?\nAND m.status = 'PENDENTE'\nORDER BY m.solicitacao_em ASC
DB --> Repo: 1.9 listaSolicitacoes
Repo --> CM: 1.10 solicitacoes
deactivate Repo

CM --> UI: 1.11 exibirSolicitacoes(lista)
UI --> M: 1.12 📋 "Solicitações pendentes:\n- Aluno: João | Data: 25/05 14h\n- Aluno: Maria | Data: 26/05 10h"
deactivate CM

== 2. Aceitar Solicitação ==

M -> UI: 2.1 selecionarSolicitacao(solicitacaoId, "ACEITAR")
activate UI
UI -> CM: 2.2 aceitarSolicitacao(solicitacaoId, token)
activate CM

CM -> Auth: 2.3 verificarToken(token)
activate Auth
Auth --> CM: 2.4 usuarioAutenticado
deactivate Auth

CM -> SM: 2.5 aceitarMentoria(solicitacaoId, mentorId)
activate SM

SM -> Repo: 2.6 buscarDetalhesSolicitacao(solicitacaoId)
activate Repo
Repo -> DB: 2.7 SELECT * FROM mentorias WHERE id = ? AND mentor_id = ?
DB --> Repo: 2.8 dadosSolicitacao
Repo --> SM: 2.9 dados
deactivate Repo

alt solicitacaoNaoEncontrada or status != "PENDENTE"
    SM --> CM: 2.10 erroSolicitacao()
    CM --> UI: 2.11 erro()
    UI --> M: 2.12 ❌ "Solicitação não encontrada ou já respondida."
    deactivate SM
    
else Solicitacao válida
    SM -> SM: 2.13 gerarLinkVideoconferencia()
    note right of SM: Gerar link do Meet/Zoom
    
    SM -> Repo: 2.14 atualizarStatus(solicitacaoId, "ACEITA", linkVideoconferencia)
    activate Repo
    Repo -> DB: 2.15 UPDATE mentorias\nSET status = 'ACEITA',\n    link_videoconferencia = ?,\n    data_resposta = NOW()\nWHERE id = ?
    DB --> Repo: 2.16 atualizado
    deactivate Repo
    
    SM --> CM: 2.17 confirmacao(linkVideoconferencia)
    deactivate SM
    
    ' === Notificar Aluno ===
    CM -> Notif: 2.18 notificarAluno(alunoId, "MENTORIA_ACEITA", linkVideoconferencia)
    activate Notif
    Notif -> Repo: 2.19 buscarContatoAluno(alunoId)
    activate Repo
    Repo -> DB: 2.20 SELECT email, telefone FROM alunos WHERE id = ?
    DB --> Repo: 2.21 contato
    deactivate Repo
    Notif -> Notif: 2.22 formatarMensagem("Sua mentoria foi aceita!\nLink: " + linkVideoconferencia)
    Notif ->> Aluno: 2.23 📧 "Mentoria confirmada!\nLink: " + linkVideoconferencia
    deactivate Notif
    
    CM --> UI: 2.24 sucesso()
    UI --> M: 2.25 ✅ "Solicitação aceita com sucesso!\nLink gerado: " + linkVideoconferencia
    deactivate CM
end

deactivate UI

== 3. Recusar Solicitação ==

M -> UI: 3.1 selecionarSolicitacao(solicitacaoId, "RECUSAR", motivo)
activate UI
UI -> CM: 3.2 recusarSolicitacao(solicitacaoId, motivo, token)
activate CM

CM -> Auth: 3.3 verificarToken(token)
activate Auth
Auth --> CM: 3.4 usuarioAutenticado
deactivate Auth

CM -> SM: 3.5 recusarMentoria(solicitacaoId, mentorId, motivo)
activate SM

SM -> Repo: 3.6 buscarDetalhesSolicitacao(solicitacaoId)
activate Repo
Repo -> DB: 3.7 SELECT * FROM mentorias WHERE id = ?
DB --> Repo: 3.8 dadosSolicitacao
Repo --> SM: 3.9 dados
deactivate Repo

alt solicitacaoNaoEncontrada or status != "PENDENTE"
    SM --> CM: 3.10 erroSolicitacao()
    CM --> UI: 3.11 erro()
    UI --> M: 3.12 ❌ "Solicitação não encontrada ou já respondida."
    
else Solicitacao válida
    SM -> Repo: 3.13 atualizarStatus(solicitacaoId, "RECUSADA", motivo)
    activate Repo
    Repo -> DB: 3.14 UPDATE mentorias\nSET status = 'RECUSADA',\n    motivo_recusa = ?,\n    data_resposta = NOW()\nWHERE id = ?
    DB --> Repo: 3.15 atualizado
    deactivate Repo
    
    ' === Estornar DevCoins do Aluno ===
    SM -> SM: 3.16 estornarDevCoins(alunoId, 100)
    note right of SM: Devolver os 100 DevCoins
    
    SM -> Repo: 3.17 atualizarSaldoDevCoins(alunoId)
    activate Repo
    Repo -> DB: 3.18 UPDATE alunos SET dev_coins = dev_coins + 100 WHERE id = ?
    DB --> Repo: 3.19 atualizado
    deactivate Repo
    
    SM --> CM: 3.20 confirmacao()
    deactivate SM
    
    ' === Notificar Aluno ===
    CM -> Notif: 3.21 notificarAluno(alunoId, "MENTORIA_RECUSADA", motivo)
    activate Notif
    Notif -> Notif: 3.22 formatarMensagem("Sua mentoria foi recusada.\nMotivo: " + motivo + "\nSeus DevCoins foram estornados.")
    Notif ->> Aluno: 3.23 📧 "Mentoria recusada.\nMotivo: " + motivo
    deactivate Notif
    
    CM --> UI: 3.24 sucesso()
    UI --> M: 3.25 ✅ "Solicitação recusada.\nAluno foi notificado e DevCoins foram estornados."
    deactivate CM
end

deactivate UI

@enduml
