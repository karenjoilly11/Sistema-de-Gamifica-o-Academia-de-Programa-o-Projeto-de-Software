@startuml
title DevLevel - Solicitar Mentoria (UC-12)

actor Aluno as A
participant "Interface\nWeb" as UI
participant "Controlador\nMentoria" as CM
participant "Serviço de\nAutenticação" as Auth
participant "Serviço de\nPermissões" as Perm
participant "Serviço de\nMentoria" as SM
participant "Serviço de\nDevCoins" as DC
participant "Repositório\nde Dados" as Repo
database "Banco de\nDados" as DB
participant "Sistema de\nNotificação" as Notif

== 1. Busca de Mentores Disponíveis ==

A -> UI: 1.1 acessarSolicitarMentoria()
activate UI

UI -> CM: 1.2 listarMentoresDisponiveis(dataHora, especialidade, token)
activate CM

CM -> Auth: 1.3 verificarToken(token)
activate Auth
Auth --> CM: 1.4 usuarioAutenticado
deactivate Auth

CM -> Perm: 1.5 verificarPapel(usuario, "ALUNO")
activate Perm
Perm --> CM: 1.6 permissaoValida
deactivate Perm

CM -> Repo: 1.7 buscarMentoresPorDisponibilidade(dataHora, especialidade)
activate Repo
Repo -> DB: 1.8 SELECT m.* FROM mentores m\nJOIN disponibilidades d ON m.id = d.mentor_id\nWHERE d.data_hora = ?\nAND m.especialidade LIKE ?
DB --> Repo: 1.9 listaMentores
Repo --> CM: 1.10 mentoresEncontrados
deactivate Repo

CM --> UI: 1.11 exibirMentores(lista)
UI --> A: 1.12 📋 "Mentores disponíveis:\n- João (Back-end)\n- Maria (Front-end)"
deactivate CM

== 2. Seleção do Mentor e Agendamento ==

A -> UI: 2.1 selecionarMentor(mentorId, dataHora)
activate UI
UI -> CM: 2.2 criarSolicitacao(mentorId, dataHora, token, mensagem)
activate CM

CM -> Auth: 2.3 verificarToken(token)
activate Auth
Auth --> CM: 2.4 usuarioAutenticado
deactivate Auth

CM -> SM: 2.5 validarDisponibilidade(mentorId, dataHora)
activate SM
SM -> Repo: 2.6 consultarDisponibilidade(mentorId, dataHora)
activate Repo
Repo -> DB: 2.7 SELECT * FROM disponibilidades\nWHERE mentor_id = ? AND data_hora = ?\nAND status = 'LIVRE'
DB --> Repo: 2.8 disponibilidade
Repo --> SM: 2.9 statusDisponibilidade
deactivate Repo

alt Mentor não disponível no horário
    SM --> CM: 2.10 erroDisponibilidade()
    CM --> UI: 2.11 erro()
    UI --> A: 2.12 ❌ "Horário indisponível.\nEscolha outro horário."
    deactivate SM
    
else Mentor disponível
    SM -> DC: 2.13 verificarSaldoDevCoins(alunoId)
    activate DC
    DC -> Repo: 2.14 consultarDevCoins(alunoId)
    activate Repo
    Repo -> DB: 2.15 SELECT dev_coins FROM alunos WHERE id = ?
    DB --> Repo: 2.16 saldoAtual
    deactivate Repo
    DC --> SM: 2.17 saldoDevCoins(saldo)
    deactivate DC
    
    alt Saldo DevCoins < 100
        SM --> CM: 2.18 erroSaldoInsuficiente()
        CM --> UI: 2.19 erro()
        UI --> A: 2.20 💰 "Saldo de DevCoins insuficiente!\nVocê tem " + saldo + " DevCoins\nNecessário: 100 DevCoins"
        deactivate SM
    else Saldo suficiente
        SM -> Repo: 2.21 criarSolicitacaoMentoria(alunoId, mentorId, dataHora, mensagem)
        activate Repo
        Repo -> DB: 2.22 INSERT INTO mentorias\n(aluno_id, mentor_id, data_hora, status, solicitacao_em)\nVALUES (?, ?, ?, 'PENDENTE', NOW())
        DB --> Repo: 2.23 idSolicitacao
        Repo --> SM: 2.24 solicitacaoCriada(idSolicitacao)
        deactivate Repo
        
        SM -> DC: 2.25 debitarDevCoins(alunoId, 100)
        activate DC
        DC -> Repo: 2.26 atualizarDevCoins(alunoId, novoSaldo)
        activate Repo
        Repo -> DB: 2.27 UPDATE alunos SET dev_coins = dev_coins - 100 WHERE id = ?
        DB --> Repo: 2.28 atualizado
        deactivate Repo
        DC --> SM: 2.29 debitoConfirmado
        deactivate DC
        
        SM --> CM: 2.30 solicitacaoRegistrada(idSolicitacao)
        deactivate SM
        
        ' === Extend: Notificar Mentor ===
        CM -> Notif: 2.31 notificarMentor(mentorId, "NOVA_SOLICITACAO", dados)
        activate Notif
        Notif -> Repo: 2.32 buscarContatoMentor(mentorId)
        activate Repo
        Repo -> DB: 2.33 SELECT email, telefone FROM mentores WHERE id = ?
        DB --> Repo: 2.34 contato
        deactivate Repo
        Notif -> Notif: 2.35 formatarMensagem("Aluno solicitou mentoria em " + dataHora)
        Notif ->> Mentor: 2.36 📧 "Nova solicitação de mentoria!\nAluno: " + alunoNome + "\nData: " + dataHora
        deactivate Notif
        
        ' === Extend: Notificar Aluno ===
        CM -> Notif: 2.37 notificarAluno(alunoId, "SOLICITACAO_ENVIADA", dados)
        activate Notif
        Notif ->> A: 2.38 📨 "Solicitação de mentoria enviada!\nAguardando resposta do mentor."
        deactivate Notif
        
        CM --> UI: 2.39 confirmacao(idSolicitacao)
        UI --> A: 2.40 ✅ "Solicitação enviada com sucesso!\nVocê receberá uma notificação quando o mentor responder."
        deactivate CM
    end
end

deactivate UI

== 3. Acompanhamento do Status da Solicitação (Extend) ==

opt Aluno consulta status da solicitação
    A -> UI: 3.1 consultarStatusSolicitacao()
    activate UI
    UI -> CM: 3.2 buscarStatus(idSolicitacao, token)
    activate CM
    
    CM -> Auth: 3.3 verificarToken(token)
    activate Auth
    Auth --> CM: 3.4 usuarioAutenticado
    deactivate Auth
    
    CM -> Repo: 3.5 consultarStatusMentoria(idSolicitacao)
    activate Repo
    Repo -> DB: 3.6 SELECT status, data_resposta FROM mentorias WHERE id = ?
    DB --> Repo: 3.7 dadosStatus
    Repo --> CM: 3.8 statusAtual
    deactivate Repo
    
    alt status == "PENDENTE"
        CM --> UI: 3.9 statusPendente()
        UI --> A: 3.10 ⏳ "Solicitação pendente.\nAguardando resposta do mentor."
    else status == "ACEITA"
        CM -> Repo: 3.11 buscarLinkVideoconferencia(idSolicitacao)
        activate Repo
        Repo -> DB: 3.12 SELECT link_meet FROM mentorias WHERE id = ?
        DB --> Repo: 3.13 link
        deactivate Repo
        CM --> UI: 3.14 statusAceita(link)
        UI --> A: 3.15 🎉 "Mentoria confirmada!\nLink: " + link + "\nData: " + dataHora
    else status == "RECUSADA"
        CM --> UI: 3.16 statusRecusada(motivo)
        UI --> A: 3.17 ❌ "Solicitação recusada.\nMotivo: " + motivo + "\nSeus DevCoins foram estornados."
    else status == "CONCLUIDA"
        CM --> UI: 3.18 statusConcluida()
        UI --> A: 3.19 🏆 "Mentoria realizada com sucesso!\nAvalie sua experiência:"
    end
    deactivate CM
    deactivate UI
end

@enduml
