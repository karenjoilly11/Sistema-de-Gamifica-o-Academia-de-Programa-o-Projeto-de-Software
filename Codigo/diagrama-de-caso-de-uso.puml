@startuml
left to right direction
skinparam packageStyle rectangle

' Atores com hierarquia de herança
actor "Usuário" as Usuario
actor "Aluno" as Aluno
actor "Mentor" as Mentor
actor "Administrador" as Admin

Aluno -up-|> Usuario
Mentor -up-|> Usuario
Admin -up-|> Usuario

' Retângulo do sistema
rectangle "DevLevel" {
  
  ' === Casos de uso principais ===
  usecase "UC-01 - Evoluir de Nível" as UC01
  usecase "UC-02 - Gerenciar Turmas" as UC02
  usecase "UC-03 - Gerenciar Conquistas" as UC03
  usecase "UC-04 - Gerenciar Conteúdos" as UC04
  usecase "UC-05 - Gerenciar Perfil" as UC05
  usecase "UC-06 - Autenticar" as UC06
  usecase "UC-07 - Ajudar Colega no Fórum" as UC07
  usecase "UC-08 - Assistir Aula" as UC08
  usecase "UC-09 - Realizar Exercício" as UC09
  usecase "UC-10 - Exportar Relatório" as UC10
  usecase "UC-11 - Gerenciar Fórum" as UC11
  usecase "UC-12 - Solicitar Mentoria" as UC12
  usecase "UC-13 - Notificar" as UC13
  usecase "UC-14 - Gerenciar Badges" as UC14
  usecase "UC-15 - Gerenciar Monitoria" as UC15
  usecase "UC-16 - Validar Permissões" as UC16
  usecase "UC-17 - Validar Desbloqueio" as UC17
  
  ' === Associações ator → caso de uso ===
  Aluno --> UC01
  Aluno --> UC07
  Aluno --> UC08
  Aluno --> UC09
  Aluno --> UC12
  
  Mentor --> UC02
  Mentor --> UC03
  Mentor --> UC10
  Mentor --> UC15
  
  Admin --> UC04
  Admin --> UC11
  Admin --> UC14
  
  Usuario --> UC05
  
  ' === Relacionamentos de include ===
  ' Include de Autenticação
  UC01 ..> UC06 : <<include>>
  UC02 ..> UC06 : <<include>>
  UC03 ..> UC06 : <<include>>
  UC04 ..> UC06 : <<include>>
  UC05 ..> UC06 : <<include>>
  UC07 ..> UC06 : <<include>>
  UC08 ..> UC06 : <<include>>
  UC09 ..> UC06 : <<include>>
  UC10 ..> UC06 : <<include>>   
  UC11 ..> UC06 : <<include>>
  UC12 ..> UC06 : <<include>>
  UC14 ..> UC06 : <<include>>
  UC15 ..> UC06 : <<include>>
  
  ' Include de Validação de Permissões
  UC02 ..> UC16 : <<include>>
  UC03 ..> UC16 : <<include>>
  UC04 ..> UC16 : <<include>>
  UC10 ..> UC16 : <<include>>
  UC11 ..> UC16 : <<include>>
  UC14 ..> UC16 : <<include>>
  UC15 ..> UC16 : <<include>>
  
  ' === Relacionamentos de extend (opcionais) ===
  ' Extend de Notificações
  UC01 <.. UC13 : <<extend>>
  UC12 <.. UC13 : <<extend>>
  
  ' Extend de Validação de Desbloqueio (NOVO)
  UC08 <.. UC17 : <<extend>>
  UC09 <.. UC17 : <<extend>>
}

@enduml
