' =====================================================
' ATRIBUTOS — CONTEUDO
' =====================================================

class "<u>id_conteudo</u>" as pk_cont <<chave>>
class "titulo" as a_ctit <<atributo>>
class "tipo" as a_ctipo <<atributo>>
class "nivel_minimo" as a_cniv <<atributo>>
class "dificuldade" as a_cdif <<atributo>>
