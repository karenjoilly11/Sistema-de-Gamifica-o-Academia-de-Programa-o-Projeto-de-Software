a_hres -- "HISTORICO_EXERCICIO"
a_hcod -- "HISTORICO_EXERCICIO"
a_hxp -- "HISTORICO_EXERCICIO"
a_hdata -- "HISTORICO_EXERCICIO"

' =====================================================
' LIGAÇÕES — HERANÇA
' =====================================================

"USUARIO" "1" -- her_aluno
her_aluno "1" -- "ALUNO"

"USUARIO" "1" -- her_mentor
her_mentor "1" -- "MENTOR"

"USUARIO" "1" -- her_adm
her_adm "1" -- "ADMINISTRADOR"

' =====================================================
' LIGAÇÕES — TURMA & MATRÍCULA
' =====================================================

"MENTOR" "1" -- rel_gerencia
rel_gerencia -- "N" "TURMA"

"TURMA" "1" -- rel_matricula
rel_matricula -- "N" "MATRICULA"
"ALUNO" "1" -- rel_matricula

' =====================================================
' LIGAÇÕES — BADGES
' =====================================================

"ALUNO" "N" -- rel_conquista
rel_conquista -- "N" "BADGE"

"ADMINISTRADOR" "1" -- rel_cria
rel_cria -- "N" "BADGE"

' =====================================================
' LIGAÇÕES — CONTEÚDO & EXERCÍCIOS
' =====================================================

"ALUNO" "N" -- rel_desbloqueia
rel_desbloqueia -- "N" "CONTEUDO"

"ALUNO" "1" -- rel_submete
rel_submete -- "N" "HISTORICO_EXERCICIO"
"CONTEUDO" "1" -- rel_submete

' =====================================================
' LIGAÇÕES — MISSÕES
' =====================================================

"ALUNO" "1" -- rel_missao
rel_missao -- "N" "MISSAO_DIARIA"

' =====================================================
' LIGAÇÕES — MENTORIAS
' =====================================================

"ALUNO" "1" -- rel_solicita
rel_solicita -- "N" "MENTORIA"

"MENTOR" "1" -- rel_atende
rel_atende -- "N" "MENTORIA"

' =====================================================
' LIGAÇÕES — FÓRUM
' =====================================================

"ALUNO" "1" -- rel_pergunta
rel_pergunta -- "N" "PERGUNTA_FORUM"

"ALUNO" "1" -- rel_responde
rel_responde -- "N" "RESPOSTA_FORUM"

"PERGUNTA_FORUM" "1" -- rel_possui_resp
rel_possui_resp -- "N" "RESPOSTA_FORUM"

' =====================================================
' LIGAÇÕES — NOTIFICAÇÕES
' =====================================================

"USUARIO" "1" -- rel_notif
rel_notif -- "N" "NOTIFICACAO"

' =====================================================
' LEGENDA
' =====================================================

legend bottom
  **Legenda — Notação Chen (ER Conceitual) — DevLevel**
  ──────────────────────────────────────────────────────────
  Azul escuro  [ ENTIDADE ]           Entidade forte
  Amarelo      < relacionamento >     Losango de relacionamento
  Cinza        ( atributo )           Atributo simples
  Azul claro   ( <u>id_x</u> )       Chave primária (sublinhado)
  Verde        (( multivalorado ))    Atributo multivalorado
  Amarelo claro  ( /derivado )        Atributo derivado
  ──────────────────────────────────────────────────────────
  Cardinalidades: "1" e "N" nas pontas das ligações
endlegend

@enduml
