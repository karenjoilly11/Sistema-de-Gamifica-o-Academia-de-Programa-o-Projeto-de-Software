@startuml DevLevel_ER_Chen_v3

hide empty members
hide circle

skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 10
skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam classAttributeIconSize 0

' =====================================================
' ENTIDADE — retângulo azul
' =====================================================
skinparam class<<entidade>> {
  BackgroundColor #DDEEFF
  BorderColor #1A5FA8
  BorderThickness 2.5
  FontColor #0D2E5A
  FontStyle Bold
  HeaderBackgroundColor #B8D4F0
}

' =====================================================
' ATRIBUTO NORMAL — elipse cinza
' =====================================================
skinparam class<<atributo>> {
  BackgroundColor #F4F4F4
  BorderColor #999999
  BorderThickness 1
  FontColor #333333
  FontStyle Normal
  HeaderBackgroundColor #F4F4F4
  RoundCorner 30
}

' =====================================================
' ATRIBUTO CHAVE — elipse azul escuro
' =====================================================
skinparam class<<chave>> {
  BackgroundColor #D0E8FF
  BorderColor #1A5FA8
  BorderThickness 2
  FontColor #0D2E5A
  FontStyle Bold
  HeaderBackgroundColor #D0E8FF
  RoundCorner 30
}

' =====================================================
' ATRIBUTO MULTIVALORADO — elipse verde borda dupla
' =====================================================
skinparam class<<multi>> {
  BackgroundColor #E8FFE8
  BorderColor #228822
  BorderThickness 3
  FontColor #114411
  FontStyle Normal
  HeaderBackgroundColor #E8FFE8
  RoundCorner 30
}

' =====================================================
' ATRIBUTO DERIVADO — elipse amarela
' =====================================================
skinparam class<<derivado>> {
  BackgroundColor #FFFFF0
  BorderColor #AAAA44
  BorderThickness 1
  FontColor #555500
  FontStyle Italic
  HeaderBackgroundColor #FFFFF0
  RoundCorner 30
}

' =====================================================
' RELACIONAMENTO — losango amarelo
' =====================================================
skinparam class<<rel>> {
  BackgroundColor #FFF5CC
  BorderColor #CC8800
  BorderThickness 2
  FontColor #5A3A00
  FontStyle Bold
  HeaderBackgroundColor #FFF5CC
}

' =====================================================
' ENTIDADES
' =====================================================

class "USUARIO" <<entidade>>
class "ALUNO" <<entidade>>
class "MENTOR" <<entidade>>
class "ADMINISTRADOR" <<entidade>>
class "TURMA" <<entidade>>
class "MATRICULA" <<entidade>>
class "BADGE" <<entidade>>
class "CONTEUDO" <<entidade>>
class "MISSAO_DIARIA" <<entidade>>
class "MENTORIA" <<entidade>>
class "PERGUNTA_FORUM" <<entidade>>
class "RESPOSTA_FORUM" <<entidade>>
class "NOTIFICACAO" <<entidade>>
class "HISTORICO_EXERCICIO" <<entidade>>

' =====================================================
' RELACIONAMENTOS (losangos)
' =====================================================

class "é um" as her_aluno <<rel>>
class "é um " as her_mentor <<rel>>
class "é um  " as her_adm <<rel>>
class "gerencia" as rel_gerencia <<rel>>
class "realiza matrícula" as rel_matricula <<rel>>
class "conquista" as rel_conquista <<rel>>
class "cria" as rel_cria <<rel>>
class "desbloqueia" as rel_desbloqueia <<rel>>
class "submete" as rel_submete <<rel>>
class "recebe missão" as rel_missao <<rel>>
class "solicita" as rel_solicita <<rel>>
class "atende" as rel_atende <<rel>>
class "publica pergunta" as rel_pergunta <<rel>>
class "publica resposta" as rel_responde <<rel>>
class "possui" as rel_possui_resp <<rel>>
class "recebe notificação" as rel_notif <<rel>>

' =====================================================
' ATRIBUTOS — USUARIO
' =====================================================

class "<u>id_usuario</u>" as pk_usuario <<chave>>
class "nome" as a_unom <<atributo>>
class "email" as a_uema <<atributo>>
class "senha_hash" as a_usen <<atributo>>
class "data_registro" as a_udreg <<atributo>>
class "status_conta" as a_ustat <<atributo>>
class "papel" as a_upap <<atributo>>
class "ultimo_login" as a_ulog <<atributo>>
class "/idade_conta" as a_uidade <<derivado>>

pk_usuario -- "USUARIO"
a_unom -- "USUARIO"
a_uema -- "USUARIO"
a_usen -- "USUARIO"
a_udreg -- "USUARIO"
a_ustat -- "USUARIO"
a_upap -- "USUARIO"
a_ulog -- "USUARIO"
a_uidade -- "USUARIO"

' =====================================================
' ATRIBUTOS — ALUNO
' =====================================================

class "<u>id_aluno</u>" as pk_aluno <<chave>>
class "nivel" as a_aniv <<atributo>>
class "xp_total" as a_axp <<atributo>>
class "dev_coins" as a_acoin <<atributo>>
class "streak_atual" as a_astr <<atributo>>
class "trilha_principal" as a_atri1 <<atributo>>
class "trilha_secundaria" as a_atri2 <<atributo>>
class "telefone" as a_atel <<multi>>

pk_aluno -- "ALUNO"
